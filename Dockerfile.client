# Build context is the monorepo root (see docker-compose.yml) so the gateway's
# shared nginx/ config directory is reachable — see the runtime stage below.

# ── Build stage ────────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

# Install dependencies first (layer cache)
COPY ArbiScannerWebApp/ArbiScannerWeb.Client/package.json ArbiScannerWebApp/ArbiScannerWeb.Client/package-lock.json ./
RUN npm ci --ignore-scripts

# Copy the rest of the client source and build
COPY ArbiScannerWebApp/ArbiScannerWeb.Client/ ./

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Run Vite directly to skip the tsc type-check step in the npm build script
RUN ./node_modules/.bin/vite build --config vite.config.prod.ts

# ── Runtime stage ──────────────────────────────────────────────────────────────
FROM nginx:alpine AS final
RUN apk add --no-cache apache2-utils
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY nginx/40-generate-prometheus-htpasswd.sh /docker-entrypoint.d/40-generate-prometheus-htpasswd.sh
RUN chmod +x /docker-entrypoint.d/40-generate-prometheus-htpasswd.sh

EXPOSE 80
EXPOSE 443
CMD ["nginx", "-g", "daemon off;"]
