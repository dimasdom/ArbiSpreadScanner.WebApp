# ── Build stage ────────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

# Install dependencies first (layer cache)
COPY ArbiScannerWeb.Client/package.json ArbiScannerWeb.Client/package-lock.json ./
RUN npm ci

# Copy the rest of the client source and build
COPY ArbiScannerWeb.Client/ ./

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Run Vite directly to skip the tsc type-check step in the npm build script
RUN npx vite build --config vite.config.prod.ts

# ── Runtime stage ──────────────────────────────────────────────────────────────
FROM nginx:alpine AS final
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
