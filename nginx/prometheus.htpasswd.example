# Basic-auth credentials file for the gateway's /prometheus/ route.
#
# Prometheus has no built-in login, so nginx gates it with auth_basic
# (see the /prometheus/ location in ../nginx.conf).
#
# Generate the real file (git-ignored, never commit it) with:
#   htpasswd -c prometheus.htpasswd <username>
# or, without the apache2-utils package:
#   printf "<username>:$(openssl passwd -apr1)\n" > prometheus.htpasswd
#
# docker-compose mounts it read-only into the web-client container at
# /etc/nginx/prometheus.htpasswd.
